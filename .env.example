# Copy to .env (make init does this) and fill in. .env is git-ignored.

# Which arm: blue (192.168.2.9) or green (192.168.2.10). ROBOT_IP, if set, overrides it.
KINOVA_ARM=blue
# ROBOT_IP=192.168.2.9

# Your OWN web-interface account (username = andrew id). Never admin/admin.
KINOVA_USERNAME=
KINOVA_PASSWORD=

# Safety caps for kinova CLI motions: linear m/s, angular deg/s
KINOVA_MAX_LIN_SPEED=0.10
KINOVA_MAX_ANG_SPEED=30

# Docker. linux/arm64 = experimental native build on Apple Silicon.
DOCKER_PLATFORM=linux/amd64
# Raise if Docker Desktop has >= 12 GB RAM
CATKIN_JOBS=2
WITH_GAZEBO=false
START_GUI=1
